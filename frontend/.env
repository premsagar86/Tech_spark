# Empty on purpose — every request is a relative path (e.g. /api/events),
# resolved against whatever origin the page is actually loaded from. In
# production, vercel.json rewrites /api/* to the Railway backend, so the browser
# never sees a cross-origin request at all — required for the non-httpOnly
# session-hint cookies (session.js) to be readable, since document.cookie is
# strictly same-origin no matter what cookie attributes are set. Local dev gets
# the same behavior via vite.config.js's dev-server proxy (VITE_API_PROXY_TARGET).
VITE_API_URL=
VITE_API_PROXY_TARGET=https://acceptable-commitment-production-d2e1.up.railway.app
VITE_REQUEST_TIMEOUT_MS=15000
