# TechSpark 2026 backend — environment variables.
# Copy to .env and fill in. Vars read via requireEnvInt()/requireEnv fail the
# boot loudly if missing or invalid, rather than falling back to a default.

# --- server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://localhost:3000
PUBLIC_API_URL=http://localhost:3000

# --- database (MySQL) ----------------------------------------------------
DB_HOST=localhost
DB_USER=techspark
DB_PASSWORD=
DB_NAME=techspark

# --- auth: JSON Web Token secrets --------------------------------------
JWT_ADMIN_SECRET=
JWT_PARTICIPANT_SECRET=
# Signs the per-attempt exam token (middleware/examAttemptAuth.js). This is the
# ONE hard requirement for the exam feature — leave it blank and every /api/exam
# route returns 503; the rest of the API is unaffected.
JWT_EXAM_SECRET=

# --- token lifetimes (ms) ---------------------------------------------
ADMIN_ACCESS_TTL_MS=900000
ADMIN_REFRESH_TTL_MS=2592000000
PARTICIPANT_ACCESS_TTL_MS=900000
PARTICIPANT_REFRESH_TTL_MS=5184000000
RECOVERY_TOKEN_TTL_MS=1800000
# Optional (default 600000) — grace added on top of an exam's duration for the
# attempt token's TTL. Safe default; not fail-loud.
EXAM_ATTEMPT_GRACE_MS=600000

# --- rate-limit windows (ms) ----------------------------------------
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
RECOVERY_RATE_LIMIT_WINDOW_MS=3600000

# --- stale-registration purge job ---------------------------------
STALE_REGISTRATION_MINUTES=30
PURGE_GRACE_HOURS=48
STALE_CHECK_INTERVAL_MS=900000

# --- proctor extension ------------------------------------------------
# Required only for exams with require_extension = true. Must match
# proctor/extension/config.js CONFIG.SHARED_SECRET. Verifies the extension
# handshake proof at POST /api/exam/:slug/start; if unset, those starts 403.
PROCTOR_EXT_SHARED_SECRET=
# Optional — how long an extension proof stays valid (default 120000).
PROCTOR_EXT_PROOF_TTL_MS=120000

# --- payments (Razorpay) --------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- email (Brevo) ------------------------------------------------------
BREVO_API_KEY=
EMAIL_FROM=

# --- misc ---------------------------------------------------------------
WHATSAPP_COMMUNITY_LINK=
